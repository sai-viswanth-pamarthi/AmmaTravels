# Amma Travels - Environment Configuration Template
# Copy this file to .env.local and fill in the values for production deployment

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Business & Support Details
NEXT_PUBLIC_BUSINESS_NAME="Amma Travels"
NEXT_PUBLIC_BUSINESS_LOCATION="Kakinada, Andhra Pradesh, India"
NEXT_PUBLIC_WHATSAPP_NUMBER="918885757966"
NEXT_PUBLIC_SUPPORT_EMAIL="contact@ammatravelskkd.com"

# Storage Bucket Names
SUPABASE_STORAGE_DOCUMENTS_BUCKET="customer-documents"
SUPABASE_STORAGE_VEHICLES_BUCKET="vehicle-images"

# Optional Payment Gateway (Phase 2 integration placeholders)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server & Admin Security Settings
PORT=5000
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="AmmaAdmin#Kkd2026"
JWT_SECRET="amma-travels-kakinada-secret-key-change-in-prod"
